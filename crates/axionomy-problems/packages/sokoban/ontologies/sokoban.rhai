for name in [
    "active",
    "at-exit",
    "away-from-exit",
    "crate/0",
    "crate/1",
    "crate/2",
    "dead-square",
    "empty",
    "floor",
    "latch-ready/0",
    "latch-ready/1",
    "latched/0",
    "latched/1",
    "player",
    "pressed/0",
    "pressed/1",
    "released/0",
    "released/1",
    "solved",
    "wall"
] {
    world.declare(asset(name));
}

for name in ["from", "goal/0", "goal/1", "goal/2", "middle", "puzzle", "to"] {
    world.declare(role(name));
}

for name in ["finish", "latch/{circuit}/{at}", "move/{from}/{to}", "push/{behind}/{crate-at}/{to}/{crate}"] {
    world.rate_pattern(name);
}

