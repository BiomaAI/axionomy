let world = ontology();

for name in [
    "buyer/a",
    "buyer/b",
    "buyer/c",
    "carrier/a",
    "carrier/b",
    "order/a",
    "order/b",
    "order/c",
    "order/d",
    "order/e",
    "order/f",
    "platform",
    "seller/a",
    "seller/b",
    "seller/c",
    "tax-authority"
] {
    world.declare(account(name));
}

for name in [
    "agreed-price/100",
    "agreed-price/105",
    "agreed-price/110",
    "agreed-price/115",
    "agreed-price/80",
    "agreed-price/85",
    "agreed-price/90",
    "agreed-price/95",
    "booking/a",
    "booking/b",
    "booking/c",
    "booking/d",
    "booking/e",
    "booking/f",
    "buyer-license",
    "carrier-license",
    "completed-sale/a",
    "completed-sale/b",
    "completed-sale/c",
    "completed-sale/d",
    "completed-sale/e",
    "completed-sale/f",
    "contract/a",
    "contract/b",
    "contract/c",
    "contract/d",
    "contract/e",
    "contract/f",
    "delivered-by/a",
    "delivered-by/b",
    "delivered-by/c",
    "delivered-by/d",
    "delivered-by/e",
    "delivered-by/f",
    "in-shipment/a",
    "in-shipment/b",
    "in-shipment/c",
    "in-shipment/d",
    "in-shipment/e",
    "in-shipment/f",
    "item/gadget",
    "item/widget",
    "late",
    "lease-until",
    "money",
    "now",
    "on-time",
    "open-order/a",
    "open-order/b",
    "open-order/c",
    "open-order/d",
    "open-order/e",
    "open-order/f",
    "purchase-intent/a",
    "purchase-intent/b",
    "purchase-intent/c",
    "purchase-intent/d",
    "purchase-intent/e",
    "purchase-intent/f",
    "purchase-locked/a",
    "purchase-locked/b",
    "purchase-locked/c",
    "purchase-locked/d",
    "purchase-locked/e",
    "purchase-locked/f",
    "purchase-receipt/a",
    "purchase-receipt/b",
    "purchase-receipt/c",
    "purchase-receipt/d",
    "purchase-receipt/e",
    "purchase-receipt/f",
    "ready-at",
    "refunded",
    "sale-offer/gadget",
    "sale-offer/widget",
    "sale-reserved/a",
    "sale-reserved/b",
    "sale-reserved/c",
    "sale-reserved/d",
    "sale-reserved/e",
    "sale-reserved/f",
    "seller-license",
    "settled-order/a",
    "settled-order/b",
    "settled-order/c",
    "settled-order/d",
    "settled-order/e",
    "settled-order/f",
    "settled-value/100",
    "settled-value/105",
    "settled-value/110",
    "settled-value/115",
    "settled-value/70",
    "settled-value/75",
    "settled-value/80",
    "settled-value/85",
    "settled-value/90",
    "settled-value/93",
    "settled-value/95",
    "shipping-capacity",
    "time-remaining",
    "used-shipping-capacity",
    "utility"
] {
    world.declare(asset(name));
}

for name in ["buyer", "carrier", "order", "platform", "seller", "tax-authority"] {
    world.declare(role(name));
}

for name in [
    "advance/{to}",
    "cancel/{order}/{discounted}",
    "contract/{order}/{discounted}",
    "deliver/{order}/{discounted}/false",
    "deliver/{order}/{discounted}/true",
    "discount-order/{order}",
    "dispatch/{order}/{carrier}",
    "settle-order/{order}"
] {
    world.rate_pattern(name);
}

world
