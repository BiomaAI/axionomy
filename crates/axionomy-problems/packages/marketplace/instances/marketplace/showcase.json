{
  "ontology": "marketplace",
  "laws": ["marketplace/showcase-and-stress"],
  "tables": {
    "cancel/{order}/{discounted}": {
      "variables": [
        {"name": "order", "values": ["a", "b", "c", "d"]},
        {"name": "discounted", "values": ["false", "true"]}
      ],
      "relations": [
        {
          "gives": ["item", "gross", "proceeds", "tax", "commission", "shipping", "buyer-utility", "seller-utility"],
          "rows": [
            ["a", "widget", "100", "80", "10", "5", "5", "30", "20"],
            ["b", "gadget", "90", "72", "9", "5", "4", "25", "18"],
            ["c", "widget", "110", "86", "11", "7", "6", "34", "17"],
            ["d", "gadget", "95", "75", "10", "5", "5", "22", "24"]
          ],
          "variables": ["order"]
        },
        {
          "gives": ["arrival", "deadline", "route-delay"],
          "rows": [["a", "0", "4", "0"], ["b", "0", "4", "0"], ["c", "2", "7", "2"], ["d", "2", "7", "0"]],
          "variables": ["order"]
        },
        {"gives": ["discount"], "rows": [["false", "0"], ["true", "10"]], "variables": ["discounted"]}
      ]
    },
    "contract/{order}/{discounted}": {
      "variables": [
        {"name": "order", "values": ["a", "b", "c", "d"]},
        {"name": "discounted", "values": ["false", "true"]}
      ],
      "relations": [
        {
          "gives": ["item", "gross", "proceeds", "tax", "commission", "shipping", "buyer-utility", "seller-utility"],
          "rows": [
            ["a", "widget", "100", "80", "10", "5", "5", "30", "20"],
            ["b", "gadget", "90", "72", "9", "5", "4", "25", "18"],
            ["c", "widget", "110", "86", "11", "7", "6", "34", "17"],
            ["d", "gadget", "95", "75", "10", "5", "5", "22", "24"]
          ],
          "variables": ["order"]
        },
        {
          "gives": ["arrival", "deadline", "route-delay"],
          "rows": [["a", "0", "4", "0"], ["b", "0", "4", "0"], ["c", "2", "7", "2"], ["d", "2", "7", "0"]],
          "variables": ["order"]
        },
        {"gives": ["discount"], "rows": [["false", "0"], ["true", "10"]], "variables": ["discounted"]}
      ]
    },
    "deliver/{order}/{discounted}/false": {
      "variables": [
        {"name": "order", "values": ["a", "b", "c", "d"]},
        {"name": "discounted", "values": ["false", "true"]}
      ],
      "relations": [
        {
          "gives": ["item", "gross", "proceeds", "tax", "commission", "shipping", "buyer-utility", "seller-utility"],
          "rows": [
            ["a", "widget", "100", "80", "10", "5", "5", "30", "20"],
            ["b", "gadget", "90", "72", "9", "5", "4", "25", "18"],
            ["c", "widget", "110", "86", "11", "7", "6", "34", "17"],
            ["d", "gadget", "95", "75", "10", "5", "5", "22", "24"]
          ],
          "variables": ["order"]
        },
        {
          "gives": ["arrival", "deadline", "route-delay"],
          "rows": [["a", "0", "4", "0"], ["b", "0", "4", "0"], ["c", "2", "7", "2"], ["d", "2", "7", "0"]],
          "variables": ["order"]
        },
        {"gives": ["discount"], "rows": [["false", "0"], ["true", "10"]], "variables": ["discounted"]}
      ]
    },
    "deliver/{order}/{discounted}/true": {
      "variables": [
        {"name": "order", "values": ["a", "b", "c", "d"]},
        {"name": "discounted", "values": ["false", "true"]}
      ],
      "relations": [
        {
          "gives": ["item", "gross", "proceeds", "tax", "commission", "shipping", "buyer-utility", "seller-utility"],
          "rows": [
            ["a", "widget", "100", "80", "10", "5", "5", "30", "20"],
            ["b", "gadget", "90", "72", "9", "5", "4", "25", "18"],
            ["c", "widget", "110", "86", "11", "7", "6", "34", "17"],
            ["d", "gadget", "95", "75", "10", "5", "5", "22", "24"]
          ],
          "variables": ["order"]
        },
        {
          "gives": ["arrival", "deadline", "route-delay"],
          "rows": [["a", "0", "4", "0"], ["b", "0", "4", "0"], ["c", "2", "7", "2"], ["d", "2", "7", "0"]],
          "variables": ["order"]
        },
        {"gives": ["discount"], "rows": [["false", "0"], ["true", "10"]], "variables": ["discounted"]}
      ]
    },
    "dispatch/{order}/{carrier}": {
      "variables": [{"name": "order", "values": ["a", "b", "c", "d"]}, {"name": "carrier", "values": ["a", "b"]}],
      "relations": [
        {
          "gives": ["arrival", "deadline", "route-delay"],
          "rows": [["a", "0", "4", "0"], ["b", "0", "4", "0"], ["c", "2", "7", "2"], ["d", "2", "7", "0"]],
          "variables": ["order"]
        },
        {
          "gives": ["transit", "exposure"],
          "rows": [["a", "2", "1"], ["b", "3", "0"]],
          "variables": ["carrier"]
        }
      ]
    }
  },
  "accounts": [
    [
      "buyer/a",
      {
        "balances": [
          ["buyer-license", "1"],
          ["money", "300"],
          ["purchase-intent/a", "1"],
          ["purchase-intent/b", "1"],
          ["purchase-intent/c", "1"]
        ]
      }
    ],
    [
      "buyer/b",
      {
        "balances": [["buyer-license", "1"], ["money", "210"], ["purchase-intent/a", "1"], ["purchase-intent/c", "1"]]
      }
    ],
    [
      "buyer/c",
      {
        "balances": [
          ["buyer-license", "1"],
          ["money", "190"],
          ["purchase-intent/a", "1"],
          ["purchase-intent/b", "1"],
          ["purchase-intent/d", "1"]
        ]
      }
    ],
    ["carrier/a", {"balances": [["carrier-license", "1"], ["shipping-capacity", "1"]]}],
    ["carrier/b", {"balances": [["carrier-license", "1"], ["shipping-capacity", "1"]]}],
    ["order/a", {"balances": [["open-order/a", "1"]]}],
    ["order/b", {"balances": [["open-order/b", "1"]]}],
    ["order/c", {"balances": [["open-order/c", "1"]]}],
    ["order/d", {"balances": [["open-order/d", "1"]]}],
    ["platform", {"balances": [["time-remaining", "32"]]}],
    ["seller/a", {"balances": [["item/widget", "2"], ["sale-offer/widget", "2"], ["seller-license", "1"]]}],
    [
      "seller/b",
      {
        "balances": [
          ["item/gadget", "1"],
          ["item/widget", "1"],
          ["sale-offer/gadget", "1"],
          ["sale-offer/widget", "1"],
          ["seller-license", "1"]
        ]
      }
    ],
    ["seller/c", {"balances": [["item/gadget", "2"], ["sale-offer/gadget", "2"], ["seller-license", "1"]]}],
    ["tax-authority", {"balances": []}]
  ],
  "invariants": [
    {"name": "money-accounting", "weights": [["money", 1]]},
    {"name": "item-accounting", "weights": [["item/widget", 1], ["item/gadget", 1]]},
    {
      "name": "buyer-order-lifecycle",
      "weights": [
        ["purchase-intent/a", 1],
        ["purchase-receipt/a", 1],
        ["purchase-intent/b", 1],
        ["purchase-receipt/b", 1],
        ["purchase-intent/c", 1],
        ["purchase-receipt/c", 1],
        ["purchase-intent/d", 1],
        ["purchase-receipt/d", 1],
        ["purchase-locked/a", 1],
        ["purchase-locked/b", 1],
        ["purchase-locked/c", 1],
        ["purchase-locked/d", 1]
      ]
    },
    {
      "name": "seller-order-lifecycle",
      "weights": [
        ["sale-offer/widget", 1],
        ["sale-offer/gadget", 1],
        ["completed-sale/a", 1],
        ["completed-sale/b", 1],
        ["completed-sale/c", 1],
        ["completed-sale/d", 1],
        ["sale-reserved/a", 1],
        ["sale-reserved/b", 1],
        ["sale-reserved/c", 1],
        ["sale-reserved/d", 1]
      ]
    },
    {
      "name": "shipping-capacity-accounting",
      "weights": [["shipping-capacity", 1], ["used-shipping-capacity", 1]]
    },
    {
      "name": "order-lifecycle",
      "weights": [
        ["open-order/a", 1],
        ["settled-order/a", 1],
        ["open-order/b", 1],
        ["settled-order/b", 1],
        ["open-order/c", 1],
        ["settled-order/c", 1],
        ["open-order/d", 1],
        ["settled-order/d", 1],
        ["contract/a", 1],
        ["in-shipment/a", 1],
        ["contract/b", 1],
        ["in-shipment/b", 1],
        ["contract/c", 1],
        ["in-shipment/c", 1],
        ["contract/d", 1],
        ["in-shipment/d", 1]
      ]
    },
    {"name": "market-time-budget", "weights": [["now", 1], ["time-remaining", 1]]}
  ]
}
