let world = ontology();

for name in [
    "nature",
    "order/0",
    "order/1",
    "order/2",
    "order/3",
    "order/4",
    "order/5",
    "station",
    "vehicle/cold",
    "vehicle/freight",
    "world"
] {
    world.declare(account(name));
}

for name in [
    "active",
    "at/depot",
    "at/east",
    "at/hub",
    "at/north",
    "at/south",
    "awaiting-outcome",
    "cargo/0",
    "cargo/1",
    "cargo/2",
    "cargo/3",
    "cargo/4",
    "cargo/5",
    "closed",
    "cold-space",
    "damage",
    "damage-count",
    "delivered",
    "delivered-count",
    "departed-at",
    "dock-space",
    "dock-used",
    "expired",
    "expired-count",
    "fuel",
    "fuel-pump",
    "in-transit",
    "integrity",
    "maintained-wear",
    "money",
    "on-main-road",
    "on-time-count",
    "part",
    "permit/cold",
    "permit/freight",
    "ready",
    "ready-at",
    "refueling",
    "repair-bay",
    "repairing",
    "resolved",
    "revenue",
    "road-space",
    "scheduled",
    "space",
    "spent-fuel",
    "staged-count",
    "tank-space",
    "ticket-divisor",
    "ticket-word/cold/depot/hub",
    "ticket-word/cold/depot/north",
    "ticket-word/cold/east/north",
    "ticket-word/cold/east/south",
    "ticket-word/cold/hub/depot",
    "ticket-word/cold/hub/north",
    "ticket-word/cold/hub/south",
    "ticket-word/cold/north/depot",
    "ticket-word/cold/north/east",
    "ticket-word/cold/north/hub",
    "ticket-word/cold/south/east",
    "ticket-word/cold/south/hub",
    "ticket-word/freight/depot/hub",
    "ticket-word/freight/depot/north",
    "ticket-word/freight/east/north",
    "ticket-word/freight/east/south",
    "ticket-word/freight/hub/depot",
    "ticket-word/freight/hub/north",
    "ticket-word/freight/hub/south",
    "ticket-word/freight/north/depot",
    "ticket-word/freight/north/east",
    "ticket-word/freight/north/hub",
    "ticket-word/freight/south/east",
    "ticket-word/freight/south/hub",
    "time",
    "time-remaining",
    "tow-truck",
    "towing",
    "transfer-count",
    "travelling/depot/hub",
    "travelling/depot/north",
    "travelling/east/north",
    "travelling/east/south",
    "travelling/hub/depot",
    "travelling/hub/north",
    "travelling/hub/south",
    "travelling/north/depot",
    "travelling/north/east",
    "travelling/north/hub",
    "travelling/south/east",
    "travelling/south/hub",
    "trip",
    "used-part",
    "used-permit/cold",
    "used-permit/freight",
    "waiting",
    "wear"
] {
    world.declare(asset(name));
}

for name in ["nature", "order", "other", "station", "vehicle", "world"] {
    world.declare(role(name));
}

for name in [
    "arrive/{van}/{from}/{to}",
    "close",
    "deliver/{van}/{order}/false",
    "deliver/{van}/{order}/true",
    "depart/{van}/{from}/{to}",
    "end-refuel/{van}",
    "end-repair/{van}/false",
    "end-repair/{van}/true",
    "end-tow/{van}",
    "expire/{order}/none/{at}",
    "expire/{order}/some/{van}/depot",
    "load/{van}/{order}/{at}",
    "refuel/{van}",
    "release/{order}",
    "repair/{van}/false",
    "repair/{van}/true",
    "resolve/{van}/{from}/{to}/{outcome}",
    "stage/{van}/{order}",
    "tick",
    "tow/{van}/{from}",
    "transfer/{from}/{to}/{order}/{at}"
] {
    world.rate_pattern(name);
}

world
