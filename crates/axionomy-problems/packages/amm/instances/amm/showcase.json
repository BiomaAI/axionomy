          ["decisions", "6"],
          ["future-need/factory", "7"],
          ["future-obligation/factory", "7"],
          ["liquidity-decision", "1"],
          ["market-open", "1"],
          ["need/factory", "1"],
          ["obligation/factory", "1"],
          ["reference-price", "10000"],
          ["storage-capacity", "2500"],
          ["trading", "1"],
          ["unmade-goods", "800"]
        ]
      }
    ],
    [
      "actor/founder",
      {
        "balances": [
          ["credit", "5000"],
          ["decisions", "6"],
          ["liquidity-decision", "1"],
          ["lp-share", "10000"],
