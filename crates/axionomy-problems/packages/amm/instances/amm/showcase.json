  "invariants": [
    {
      "name": "closed-energy-accounting",
      "weights": [["energy", 1], ["solar-potential", 1], ["spent-energy", 1]]
    },
    {"name": "closed-credit-accounting", "weights": [["credit", 1]]},
    {"name": "liquidity-share-accounting", "weights": [["lp-share", 1], ["unissued-lp-share", 1]]},
    {
      "name": "actor-goal-lifecycle",
      "weights": [
        ["need/factory", 1],
        ["satisfied-need/factory", 1],
        ["need/household", 1],
        ["satisfied-need/household", 1],
        ["obligation/generator", 1],
        ["settled-obligation/generator", 1],
        ["obligation/factory", 1],
        ["settled-obligation/factory", 1],
        ["future-need/factory", 1],
        ["missed-need/factory", 1],
        ["future-need/household", 1],
        ["missed-need/household", 1],
        ["future-obligation/factory", 1],
        ["defaulted-obligation/factory", 1],
        ["future-obligation/generator", 1],
        ["defaulted-obligation/generator", 1]
      ]
    },
    {
      "name": "shortage-knowledge-lifecycle",
      "weights": [["uninformed/speculator", 1], ["informed/speculator", 1]]
    },
    {"name": "market-lifecycle", "weights": [["market-active", 1], ["market-ended", 1]]},
    {
      "name": "production-capacity-lifecycle",
      "weights": [["production-capacity", 1], ["future-capacity", 1], ["pending-capacity", 1]]
    },
    {
      "name": "manufactured-goods-lifecycle",
      "weights": [["unmade-goods", 1], ["goods", 1], ["delivered-goods", 1]]
    },
    {
      "name": "income-entitlement-lifecycle",
      "weights": [["future-income", 1], ["income-due", 1], ["received-income", 1], ["missed-income", 1]]
    }
  ]
}
