{
  "ontology": "amm",
  "laws": ["amm/showcase", "amm/showcase-and-stress"],
  "tables": {
    "advance-day/{day}": {
      "variables": [{"name": "day", "range": ["0", "6"]}],
      "relations": [
        {
          "gives": ["sunlight", "shortage"],
          "rows": [
            ["0", "40", "0"],
            ["1", "100", "0"],
            ["2", "100", "1"],
            ["3", "40", "0"],
            ["4", "100", "1"],
            ["5", "40", "0"],
            ["6", "100", "0"]
          ],
          "variables": ["day"]
        }
      ]
    }
  },
  "constants": {
    "batch": "100",
    "daily-decisions": "6",
    "fee-denominator": "1000",
    "fee-numerator": "997",
    "project-capacity": "400",
    "scale": "1",
    "season-length": "8",
    "share-limit": "1000000"
  },
  "accounts": [
    [
      "actor/adaptive-lp",
      {
        "balances": [
          ["credit", "20000"],
          ["decisions", "6"],
          ["energy", "2000"],
          ["liquidity-decision", "1"],
          ["market-open", "1"],
          ["reference-price", "10000"],
          ["storage-capacity", "3000"],
          ["trading", "1"]
        ]
      }
    ],
