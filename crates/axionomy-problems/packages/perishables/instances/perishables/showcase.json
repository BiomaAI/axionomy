{
  "ontology": "perishables/cold-chain",
  "laws": ["perishables/cold-chain/common"],
  "tables": {
    "open-day/{day}": {
      "variables": [{"name": "day", "range": ["1", "5"]}],
      "relations": [
        {
          "gives": ["grid-supply"],
          "rows": [["1", "3"], ["2", "3"], ["3", "0"], ["4", "0"], ["5", "3"]],
          "variables": ["day"]
        }
      ]
    }
  },
  "constants": {"battery": "6", "days": "6"},
  "accounts": [
    ["batch/0", {"balances": [["active", "1"], ["at/warehouse", "1"], ["fresh", "6"], ["origin/0", "1"]]}],
    [
      "batch/1",
      {
        "balances": [["active", "1"], ["at/fridge", "1"], ["cold-occupancy", "4"], ["fresh", "4"], ["origin/1", "1"]]
      }
    ],
    ["batch/2", {"balances": [["dormant", "1"]]}],
    ["batch/3", {"balances": [["dormant", "1"]]}],
    ["batch/4", {"balances": [["dormant", "1"]]}],
    ["batch/5", {"balances": [["dormant", "1"]]}],
    ["buyer", {"balances": [["money", "36"]]}],
    [
      "world",
      {
        "balances": [
          ["cooling-off", "1"],
          ["decisions", "1"],
          ["demand", "2"],
          ["energy", "3"],
          ["freight", "2"],
          ["fuel", "6"],
          ["future-demand", "10"],
          ["future-freight", "10"],
          ["future-labor", "10"],
          ["grid-potential", "9"],
          ["labor", "2"]
        ]
      }
    ]
  ],
  "invariants": [
    {
      "name": "food-mass",
      "weights": [["fresh", 1], ["preserved", 1], ["spoiled", 1], ["disposed", 1], ["delivered", 1]]
    },
    {"name": "batch-activation", "weights": [["active", 1], ["dormant", 1]]},
    {"name": "physical-cold-storage", "weights": [["cold-space", 1], ["cold-occupancy", 1]]},
    {
      "name": "closed-electricity-and-fuel-potential",
      "weights": [
        ["energy", 1],
        ["spent-energy", 1],
        ["grid-potential", 1],
        ["spilled-energy", 1],
        ["fuel", 3],
        ["transport-fuel", 3]
      ]
    },
    {"name": "finite-fuel", "weights": [["fuel", 1], ["generator-fuel", 1], ["transport-fuel", 1]]},
    {"name": "cooling-switch", "weights": [["cooling-on", 1], ["cooling-off", 1]]},
    {
      "name": "finite-labor",
      "weights": [["labor", 1], ["spent-labor", 1], ["future-labor", 1], ["unused-labor", 1]]
    },
    {
      "name": "daily-transport-capacity",
      "weights": [["freight", 1], ["used-freight", 1], ["future-freight", 1], ["unused-freight", 1]]
    },
    {
      "name": "daily-food-obligations",
      "weights": [["demand", 1], ["future-demand", 1], ["satisfied-demand", 1], ["missed-demand", 1]]
    },
    {"name": "funded-food-purchases", "weights": [["money", 1]]},
    {"name": "cold-chain-lifecycle", "weights": [["decisions", 1], ["aging", 1], ["solved", 1]]}
  ]
}
