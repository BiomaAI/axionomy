  ],
  [
    "treat",
    {
      "accounts": [["medic", "agent/medic"], ["mission", "mission"], ["scout", "agent/scout"]],
      "consume": [
        ["medic", [["medical-kit", "1"]]],
        ["mission", [["needs-treatment", "1"], ["time-remaining", "1"]]],
        ["scout", [["injured", "1"]]]
