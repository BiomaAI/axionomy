[
  [
    "pay-bill",
    {
      "accounts": [["borrower", "borrower"], ["clock", "clock"], ["supplier", "supplier"]],
      "conditions": [
        {
          "comparison": "less_than_or_equal",
          "left": {
            "kind": "add",
            "left": {"asset": "elapsed-period", "kind": "balance", "role": "clock"},
            "right": {"kind": "constant", "value": "1"}
          },
          "name": "paid-before-the-deadline",
          "right": {"kind": "constant", "value": "2"}
        }
      ],
      "consume": [["borrower", [["cash", "2500"]]], ["supplier", [["invoice", "1"]]]],
      "distinct": [],
      "preserve": [],
      "produce": [["borrower", [["bill-paid", "1"]]], ["supplier", [["cash", "2500"]]]]
    }
  ]
]
