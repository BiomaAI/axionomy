{
  "ontology": "lending",
  "laws": ["lending/common", "lending/showcase-bill"],
  "tables": {
    "collect-revenue/{installment}": {
      "variables": [{"name": "installment", "range": ["0", "1"]}],
      "relations": [
        {
          "gives": ["amount", "due"],
          "rows": [["0", "4000", "4"], ["1", "6000", "6"]],
          "variables": ["installment"]
        }
      ]
    }
  },
  "constants": {
    "base-rate": "2000000000000000",
    "kink": "800000000000000000",
    "liquidation-bonus": "80000000000000000",
    "liquidation-threshold": "750000000000000000",
    "loan-to-value": "600000000000000000",
    "price-drop": "20",
    "reserve-factor": "100000000000000000",
    "shock-after": "4",
    "slope-above-kink": "500000000000000000",
    "slope-below-kink": "25000000000000000"
  },
  "accounts": [
    ["borrower", {"balances": [["cash", "1000"], ["collateral", "400"]]}],
    ["clock", {"balances": [["period", "8"]]}],
    ["customer", {"balances": [["cash", "10000"], ["purchase-order/0", "1"], ["purchase-order/1", "1"]]}],
    ["depositor/0", {"balances": [["cash", "2000"]]}],
    ["depositor/1", {"balances": [["cash", "2000"]]}],
    ["depositor/2", {"balances": [["cash", "2000"]]}],
    ["keeper", {"balances": [["cash", "20000"]]}],
    [
      "market",
      {
        "balances": [
          ["borrow-index", "1000000000000000000"],
          ["cash", "1000"],
          ["collateral-price", "50"],
          ["locked-share", "1000"],
          ["share-supply", "1000"]
        ]
      }
    ],
    ["oracle", {"balances": [["pending-shock", "1"]]}],
    ["supplier", {"balances": [["invoice", "1"]]}]
  ],
  "invariants": [
    {"name": "cash", "weights": [["cash", 1]]},
    {"name": "vault-shares", "weights": [["share", 1], ["locked-share", 1], ["share-supply", -1]]},
    {"name": "debt-shares", "weights": [["debt-share", 1], ["debt-share-supply", -1]]},
    {"name": "collateral", "weights": [["collateral", 1], ["posted-collateral", 1]]}
  ]
}
